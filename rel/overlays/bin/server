#!/bin/sh
set -eu

if [ "${EMBEDDED_POSTGRES:-false}" = "true" ]; then
  export DATABASE_URL="${DATABASE_URL:-postgres://postgres@127.0.0.1:5432/heidy_api}"

  pgdata="${PGDATA:-/data/postgres}"
  pglog="${PGLOG:-/data/postgres.log}"

  mkdir -p "$pgdata"
  chown -R postgres:postgres /data

  if [ ! -s "$pgdata/PG_VERSION" ]; then
    echo "Initializing embedded Postgres" >&2
    runuser -u postgres -- /usr/lib/postgresql/15/bin/initdb \
      -D "$pgdata" \
      --encoding=UTF8 \
      --locale=C \
      --auth-local=trust \
      --auth-host=trust
  fi

  echo "Starting embedded Postgres" >&2
  runuser -u postgres -- /usr/lib/postgresql/15/bin/pg_ctl \
    -D "$pgdata" \
    -l "$pglog" \
    -o "-c listen_addresses=127.0.0.1 -c unix_socket_directories=/tmp" \
    -w \
    start

  if ! runuser -u postgres -- psql -h 127.0.0.1 -U postgres -tAc "SELECT 1 FROM pg_database WHERE datname = 'heidy_api'" | grep -q 1; then
    echo "Creating embedded Postgres database" >&2
    runuser -u postgres -- createdb -h 127.0.0.1 -U postgres heidy_api
  fi

  echo "Running database migrations" >&2
  RELEASE_COMMAND=1 /app/bin/heidy_api eval "HeidyApi.Release.migrate()"
fi

exec /app/bin/heidy_api start
